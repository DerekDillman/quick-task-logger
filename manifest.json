{
  "manifest_version": 3,
  "name": "Quick Task Logger",
  "short_name": "Task Logger",
  "version": "3.0.0",
  "description": "Keyboard-first work log and timer for IT pros: one-line entry, ticket auto-detect, timesheets, standups and reports. 100% local.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "unlimitedStorage", "alarms", "notifications", "contextMenus", "activeTab"],
  "action": {
    "default_popup": "src/pages/popup.html",
    "default_title": "Quick Task Logger (Ctrl+Shift+L)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "options_page": "src/pages/dashboard.html",
  "omnibox": { "keyword": "tl" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+L", "mac": "Command+Shift+L" },
      "description": "Open Quick Task Logger"
    },
    "stop-timer": {
      "suggested_key": { "default": "Alt+Shift+K", "mac": "Alt+Shift+K" },
      "description": "Stop the running timer"
    },
    "open-dashboard": {
      "suggested_key": { "default": "Alt+Shift+L", "mac": "Alt+Shift+L" },
      "description": "Open the dashboard"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
  }
}
